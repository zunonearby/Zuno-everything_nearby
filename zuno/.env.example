# =====================================================================
# ZUNO — Environment Variables
# Copy this file to .env (root) and/or into each app as needed.
# Never commit a real .env file.
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE (shared across all four apps)
# ---------------------------------------------------------------------
# PUBLIC — safe to expose to mobile/web clients
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-ONLY — NEVER expose to any client bundle (mobile or web).
# Only used in trusted server contexts (Next.js server actions /
# route handlers, Supabase Edge Functions).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# PAYMENTS (Razorpay) — SERVER-ONLY except the public key id
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=            # PUBLIC
RAZORPAY_KEY_SECRET=        # SERVER-ONLY

# ---------------------------------------------------------------------
# MAPS
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=        # PUBLIC (restrict by platform/referrer in Google Cloud Console)

# ---------------------------------------------------------------------
# ANALYTICS (PostHog) — behavioral analytics only, never transactional
# ---------------------------------------------------------------------
POSTHOG_KEY=                 # PUBLIC
POSTHOG_HOST=                # PUBLIC, e.g. https://app.posthog.com

# ---------------------------------------------------------------------
# APP META
# ---------------------------------------------------------------------
NODE_ENV=development
